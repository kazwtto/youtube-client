{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the app's local interface.",
  "windows": ["main", "auth_modal"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-show",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "allow-app-version",
    "allow-set-webview-visible",
    "allow-set-launcher-route-active",
    "allow-yt-navigate",
    "allow-yt-play-video",
    "allow-yt-suggest",
    "allow-open-auth-modal",
    "allow-close-auth-modal",
    "allow-reload-auth-modal",
    "allow-back-auth-modal",
    "allow-is-auth-modal-visible",
    "allow-set-masthead-integrated",
    "allow-set-ui-elevation",
    "allow-pip-open",
    "allow-pip-close",
    "allow-pip-next",
    "allow-pip-restore",
    "dialog:allow-open",
    "allow-theme-list",
    "allow-theme-get",
    "allow-settings-get",
