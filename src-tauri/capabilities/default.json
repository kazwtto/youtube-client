{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the app's local interface.",
  "windows": ["main", "menu", "auth_modal"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-show",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "allow-app-version",
    "allow-set-webview-visible",
    "allow-set-launcher-route-active",
    "allow-yt-navigate",
    "allow-yt-play-video",
    "allow-yt-suggest",
    "allow-show-context-menu",
    "allow-hide-context-menu",
    "allow-is-context-menu-visible",
    "allow-open-auth-modal",
    "allow-close-auth-modal",
    "allow-reload-auth-modal",
    "allow-back-auth-modal",
    "allow-is-auth-modal-visible",
    "allow-set-masthead-integrated",
    "allow-set-ui-elevation",
    "allow-pip-open",
    "allow-pip-close",
    "allow-pip-next",
    "allow-pip-restore",
    "dialog:allow-open",
    "allow-theme-list",
    "allow-theme-get",
    "allow-settings-get",
    "allow-settings-update",
    "allow-extensions-list",
    "allow-extensions-refresh",
    "allow-extensions-install",
    "allow-extensions-uninstall",
    "allow-extensions-set-enabled",
    "allow-rpc-status",
    "allow-history-list",
    "allow-history-clear",
    "allow-history-delete",
    "allow-browser-data-sources",
    "allow-browser-history-import",
    "allow-open-repository",
    "allow-player-snapshot",
    "allow-auth-snapshot",
    "allow-request-auth-snapshot",
    "allow-youtube-loading-state",
    "allow-request-youtube-titlebar-icons"
  ]
}
