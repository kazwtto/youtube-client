    "allow-tab-sleep",
    "allow-tab-sidebar-peek",
    "allow-tab-dock-peek",
    "allow-set-sidebar-width",
    "allow-tab-open-action-menu",
    "allow-tabs-clear-isolated-data",
    "allow-set-tab-dock-width",
    "allow-tab-open-context-menu",
    "allow-updates-check",
    "allow-updates-last-status",
    "allow-updates-open-url",
    "allow-browser-data-sources",
    "allow-browser-history-import",
    "allow-open-repository",
