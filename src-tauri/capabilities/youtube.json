{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "youtube",
  "description": "Allows the injected YouTube scripts to read the theme, report playback and account state, resume history progress, and remember the last page.",
  "webviews": ["yt"],
  "local": false,
  "remote": {
    "urls": [
      "https://youtube.com",
      "https://www.youtube.com",
      "https://*.youtube.com"
    ]
  },
  "permissions": [
    "allow-theme-get",
    "allow-player-snapshot",
    "allow-auth-snapshot",
    "allow-history-resume-position",
    "allow-remember-youtube-page",
    "allow-youtube-titlebar-icons-snapshot",
    "allow-set-native-pip-active",
    "allow-native-pip-return",
    "allow-youtube-surface-painted"
  ]
}
